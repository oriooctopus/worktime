<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.oliver.worktime-bar</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/oliver/.claude/bin/worktime-bar/WorktimeBar.app/Contents/MacOS/WorktimeBar</string>
	</array>
	<!-- Unset, launchd throttles an agent's I/O, and the probe it spawns
	     inherits that: prompt-count's transcript walk went from 0.3s to 25s+,
	     past the bar's 30s kill, so nearly every status poll died. -->
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/worktime-bar.err</string>
	<key>StandardOutPath</key>
	<string>/tmp/worktime-bar.log</string>
</dict>
</plist>
