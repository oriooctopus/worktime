<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.oullman.calendar-refresh</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-lc</string>
		<string>"$HOME/.claude/bin/calendar-refresh.sh"</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/oliver/.local/log/calendar-refresh.log</string>
	<key>StandardOutPath</key>
	<string>/Users/oliver/.local/log/calendar-refresh.log</string>
	<!-- The probe refuses a snapshot over CAL_STALE_HOURS (6) old, so this has
	     to be comfortably under that: two hours leaves room for two failed
	     runs before the day goes calendar-blind, which is the state that made
	     a 15-minute Zoom call read as four slivers of foreground. -->
	<key>StartInterval</key>
	<integer>7200</integer>
	<key>WorkingDirectory</key>
	<string>/Users/oliver</string>
</dict>
</plist>
